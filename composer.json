{
  "name": "zizini/livestock-marketplace-mvp",
  "description": "Laravel Blade MVP shell for Zizini.co.ke livestock contact marketplace.",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0"
  },
  "autoload": {
    "files": [
      "app/Support/mb_split_polyfill.php"
    ],
    "classmap": [
      "database/seeders"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
